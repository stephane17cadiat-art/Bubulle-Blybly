rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // Le lien d'invitation contient un identifiant aléatoire long.
      // Seuls les utilisateurs authentifiés anonymement peuvent accéder à la partie.
      // Pour une version commerciale, renforcer ces règles avec des Cloud Functions
      // qui valident strictement le rôle et les champs modifiables.
      allow read, write: if request.auth != null;
    }
  }
}